APP_NAME="Yuki Auction"
APP_ENV=local
APP_KEY=base64:a+55L3xmIhtKH3SFjxv9dJ+CEfYmrA15AAeeMDbZxUk=
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# === DB: PostgreSQL in Docker ===
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=yuki_koi
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_SCHEMA=public
DB_SSLMODE=disable

# === OAuth Google ===
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# === Sessions/Cache/Queue: gunakan Redis antar-kontainer ===
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Perkuat cookie di lokal (akan lebih ketat di prod/HTTPS)
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=strict

FILESYSTEM_DISK=s3

QUEUE_CONNECTION=redis
CACHE_STORE=redis
CACHE_DRIVER=redis
CACHE_PREFIX=

# Redis (client phpredis sudah terpasang di image)
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# === Mailer (tetap log di lokal; ganti ke SMTP kalau mau tes kirim nyata)
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# === Object Storage (MinIO / S3 compatible) ===
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123

AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin123
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=yukikoi-media
AWS_URL=http://minio:9000/yukikoi-media
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# === Imgproxy ===
IMGPROXY_URL=http://localhost:8090
IMGPROXY_SOURCE_URL_BASE=http://minio:9000
# generate with: openssl rand -hex 32
IMGPROXY_KEY=cd5cab84bfa047b082c40b7331dadf8a25b6d0290368c464e4a2dc610292d902
IMGPROXY_SALT=4ef4fa7c80d4945a680a91c9fcec36cd
IMGPROXY_SIGN_URLS=true
IMGPROXY_ALLOW_INSECURE_URLS=true

# === Reverb (WebSocket) — biarkan dulu; butuh service terpisah bila dipakai di Docker
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=132378
REVERB_APP_KEY=lxbdsmj2uuhtmg4yt042
REVERB_APP_SECRET=8pwidjmvk1m6fnq22ui4
REVERB_HOST="reverb"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="localhost"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# === Xendit (jangan commit .env ke repo publik)
XENDIT_API_KEY="xnd_development_r2Vlkgd8nP3Hhq7Rh3t61r5mT2Q2pHPzfytt35Z8KnBH910mGwdts5KdjbEgfs"

